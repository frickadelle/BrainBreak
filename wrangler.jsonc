{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "brainbreak",
  "account_id": "d5681fce1bd5b800af3abebb63a619c1",
  "main": "worker/index.ts",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"],
  },
  "durable_objects": {
    "bindings": [{ "name": "ROOMS", "class_name": "BrainbreakRoom" }],
  },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["BrainbreakRoom"] }],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "brainbreak",
      "database_id": "c391cf12-1690-4376-a640-7b971c4d1cb6",
      "migrations_dir": "migrations",
    },
  ],
  "observability": { "enabled": true },
}

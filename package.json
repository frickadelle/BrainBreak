{
  "name": "brainbreak",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build && wrangler dev --port 8787",
    "dev:ui": "vite --host 127.0.0.1",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "db:local": "wrangler d1 migrations apply DB --local",
    "deploy": "npm run typecheck && npm run build && wrangler deploy",
    "test:protocol": "node scripts/guided-test.mjs",
    "test:protocol:legacy": "node scripts/protocol-test.mjs"
  },
  "dependencies": {
    "@fontsource-variable/dm-sans": "^5.3.0",
    "@fontsource-variable/outfit": "^5.3.0",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261009.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "playwright": "^1.51.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^5.0.3",
    "wrangler": "^4.40.0",
    "ws": "^8.18.0"
  }
}
